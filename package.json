{
  "name": "shortlink-api",
  "description": "ShortLink is a URL shortening api that encodes a long URL and decodes the short URL",
  "version": "1.0.0",
  "main": "build/src/index.js",
  "scripts": {
    "prepare": "husky",
    "prettify": "prettier --ignore-path .gitignore --config .prettierrc \"src/**/*.ts\" --write",
    "prettify:check": "prettier --check \"**/*.ts\"",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix",
    "prebuild": "rm -rf build",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start:prod": "node build/src/index.js",
    "prod": "cross-env NODE_ENV=production npm run build && cross-env NODE_ENV=production npm run start:prod",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "precommit": "npm run lint:check && npm run prettify:check && npm test",
    "prepush": "npm run lint:check"
  },
  "keywords": [
    "short link",
    "url shortener",
    "encode",
    "decode"
  ],
  "author": "Olusegun Ekoh",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^1.0.41",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ua-parser-js": "^0.7.39",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
